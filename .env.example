# Site Configuration
# Update this with your actual domain when deploying
SITE_URL=https://charlywebster.com

# Giscus Configuration (for blog comments)
# Get these values from https://giscus.app after setting up GitHub Discussions
# PUBLIC_ prefix makes these available to client-side code in Astro
PUBLIC_GISCUS_REPO=webstercharly/personal-site
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Blog Comments
PUBLIC_GISCUS_CATEGORY_ID=
