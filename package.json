{
  "name": "personal-site",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "screenshots": "node test/take-screenshots.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:editorial": "node --test test/editorial-audit.test.mjs",
    "test:site": "node --test test/site-validation.test.mjs",
    "test:seo": "node --test test/seo-identity.test.mjs",
    "validate:site": "node scripts/validate-site.mjs dist",
    "audit:drafts": "node scripts/editorial-audit.mjs",
    "audit:posts": "node scripts/editorial-audit.mjs --all"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "js-yaml": "^5.4.1",
    "puppeteer": "^25.10.0"
