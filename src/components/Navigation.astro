---
import { SITE_NAME } from '@lib/constants';

const currentPath = Astro.url.pathname;
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a href="/" aria-label={`${SITE_NAME} home`} class="wordmark">CW<span aria-hidden="true">.</span></a>

    <div class="nav-links">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Writing</a>

      <button id="theme-toggle" type="button" aria-label="Switch colour theme" aria-pressed="false">
        <svg id="theme-toggle-dark-icon" class="hidden" aria-hidden="true" viewBox="0 0 20 20">
          <path d="M17.3 13.3A8 8 0 0 1 6.7 2.7a8 8 0 1 0 10.6 10.6Z"></path>
        </svg>
        <svg id="theme-toggle-light-icon" class="hidden" aria-hidden="true" viewBox="0 0 20 20">
          <path d="M10 2v2m0 12v2m8-8h-2M4 10H2m13.7-5.7-1.4 1.4M5.7 14.3l-1.4 1.4m11.4 0-1.4-1.4M5.7 5.7 4.3 4.3M14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');
  const lightIcon = document.getElementById('theme-toggle-light-icon');

  function syncThemeControl() {
    const isDark = document.documentElement.classList.contains('dark');
    darkIcon?.classList.toggle('hidden', isDark);
    lightIcon?.classList.toggle('hidden', !isDark);
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
  }

  syncThemeControl();

  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeControl();
  });
</script>

<script>
  const isDark = document.documentElement.classList.contains('dark');
  const brandAccents = isDark
    ? ['#45d582', '#fa72a8', '#f2ca5b']
    : ['#27b467', '#e8548f', '#e6b93f'];
  const randomValue = crypto.getRandomValues(new Uint32Array(1))[0] ?? 0;
  const randomIndex = randomValue % brandAccents.length;
  const brandAccent = brandAccents[randomIndex] ?? (isDark ? '#45d582' : '#27b467');
  document.documentElement.style.setProperty('--brand-accent', brandAccent);
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    width: min(100% - 2rem, 760px);
    min-height: 64px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .wordmark span {
    color: var(--brand-accent, var(--color-accent-pink));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 3vw, 1rem);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .nav-links a,
  #theme-toggle {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links a {
    position: relative;
    padding-inline: 0.45rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    right: 0.45rem;
    bottom: 7px;
    left: 0.45rem;
    height: 3px;
    background: var(--color-accent-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  #theme-toggle {
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  #theme-toggle:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  #theme-toggle svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  #theme-toggle-dark-icon {
    fill: currentColor;
    stroke: none;
  }
</style>
