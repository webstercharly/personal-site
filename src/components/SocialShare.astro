---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const blueskyText = `${title} — ${url}`;
const blueskyUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(blueskyText)}`;
---

<aside class="share-panel" aria-labelledby="share-heading" data-share-panel data-url={url}>
  <div>
    <p class="share-kicker">Worth passing on?</p>
    <h2 id="share-heading">Share this post</h2>
  </div>

  <div class="share-actions">
    <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={blueskyUrl} target="_blank" rel="noopener noreferrer">Bluesky</a>
    <button type="button" data-copy-link>Copy link</button>
  </div>
  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-share-panel]').forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>('[data-copy-link]');
    const status = panel.querySelector<HTMLElement>('[data-share-status]');
    const url = panel.dataset.url;

    button?.addEventListener('click', async () => {
      if (!url || !status) return;

      try {
        await navigator.clipboard.writeText(url);
        button.textContent = 'Copied';
        status.textContent = 'Link copied to clipboard.';
      } catch {
        button.textContent = 'Copy failed';
        status.textContent = 'Could not copy the link. Copy it from the address bar instead.';
      }

      window.setTimeout(() => {
        button.textContent = 'Copy link';
        status.textContent = '';
      }, 2500);
    });
  });
</script>

<style>
  .share-panel {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block: 4rem;
    padding: 1.5rem 0;
    border-block: 1px solid var(--color-border);
  }

  .share-kicker {
    margin-bottom: 0.3rem;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  h2 {
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 750;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .share-actions a,
  .share-actions button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.24em;
  }

  .share-actions a:nth-child(1) { text-decoration-color: var(--color-accent-green); }
  .share-actions a:nth-child(2) { text-decoration-color: var(--color-accent-pink); }
  .share-actions button { text-decoration-color: var(--color-accent-yellow); }

  .share-actions a:hover,
  .share-actions button:hover {
    text-decoration-thickness: 0.22em;
  }

  .share-status {
    position: absolute;
    right: 0;
    bottom: -1.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (max-width: 600px) {
    .share-panel {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }

    .share-actions {
      justify-content: flex-start;
    }

    .share-status {
      right: auto;
      left: 0;
    }
  }
</style>
