---
interface Props {
  type?: 'info' | 'warning' | 'tip' | 'danger' | 'success';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info: {
    icon: 'ℹ️',
    bgLight: 'bg-blue-50',
    bgDark: 'dark:bg-blue-950',
    border: 'border-blue-500',
    text: 'text-blue-900 dark:text-blue-100',
    titleColor: 'text-blue-800 dark:text-blue-200',
  },
  warning: {
    icon: '⚠️',
    bgLight: 'bg-yellow-50',
    bgDark: 'dark:bg-yellow-950',
    border: 'border-yellow-500',
    text: 'text-yellow-900 dark:text-yellow-100',
    titleColor: 'text-yellow-800 dark:text-yellow-200',
  },
  tip: {
    icon: '💡',
    bgLight: 'bg-green-50',
    bgDark: 'dark:bg-green-950',
    border: 'border-green-500',
    text: 'text-green-900 dark:text-green-100',
    titleColor: 'text-green-800 dark:text-green-200',
  },
  danger: {
    icon: '🚨',
    bgLight: 'bg-red-50',
    bgDark: 'dark:bg-red-950',
    border: 'border-red-500',
    text: 'text-red-900 dark:text-red-100',
    titleColor: 'text-red-800 dark:text-red-200',
  },
  success: {
    icon: '✅',
    bgLight: 'bg-emerald-50',
    bgDark: 'dark:bg-emerald-950',
    border: 'border-emerald-500',
    text: 'text-emerald-900 dark:text-emerald-100',
    titleColor: 'text-emerald-800 dark:text-emerald-200',
  },
};

const style = config[type];
---

<div
  class={`callout p-4 my-6 border-l-4 rounded-r ${style.bgLight} ${style.bgDark} ${style.border} ${style.text}`}
  role="note"
>
  <div class="flex items-start gap-3">
    <span class="text-2xl flex-shrink-0" aria-hidden="true">
      {style.icon}
    </span>
    <div class="flex-1">
      {title && (
        <p class={`font-bold mb-2 ${style.titleColor}`}>
          {title}
        </p>
      )}
      <div class="prose-sm dark:prose-invert max-w-none">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .callout {
    transition: all 0.2s ease;
  }

  .callout:hover {
    transform: translateX(2px);
  }
</style>
