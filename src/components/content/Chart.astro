---
/**
 * Chart Component
 *
 * Simple CSS-based bar chart for displaying metrics and comparisons
 *
 * Usage:
 * <Chart
 *   title="Performance Improvement"
 *   data={[
 *     { label: 'Before', value: 45, color: 'red' },
 *     { label: 'After', value: 95, color: 'green' }
 *   ]}
 *   unit="%"
 *   max={100}
 * />
 */

interface ChartData {
  label: string;
  value: number;
  color?: 'blue' | 'green' | 'purple' | 'orange' | 'red' | 'yellow';
  description?: string;
}

interface Props {
  title?: string;
  data: ChartData[];
  unit?: string;
  max?: number;
  height?: 'sm' | 'md' | 'lg';
}

const {
  title,
  data,
  unit = '',
  max,
  height = 'md',
} = Astro.props;

// Calculate max value if not provided
const maxValue = max ?? Math.max(...data.map(d => d.value)) * 1.1;

// Calculate percentages for bar widths
const dataWithPercentages = data.map(item => ({
  ...item,
  percentage: (item.value / maxValue) * 100,
}));

const colors = {
  blue: 'bg-blue-500',
  green: 'bg-green-500',
  purple: 'bg-purple-500',
  orange: 'bg-orange-500',
  red: 'bg-red-500',
  yellow: 'bg-yellow-500',
};

const heights = {
  sm: 'h-8',
  md: 'h-12',
  lg: 'h-16',
};
---

<div class="chart-component my-8 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
  {title && (
    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6">
      {title}
    </h3>
  )}

  <div class="space-y-4">
    {dataWithPercentages.map((item) => (
      <div class="chart-bar-wrapper">
        <div class="flex justify-between items-baseline mb-2">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
            {item.label}
          </span>
          <span class="text-lg font-bold text-gray-900 dark:text-gray-100">
            {item.value}{unit}
          </span>
        </div>

        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div
            class={`${colors[item.color || 'blue']} ${heights[height]} rounded-full transition-all duration-1000 ease-out flex items-center justify-end pr-3`}
            style={`width: ${item.percentage}%`}
            role="progressbar"
            aria-valuenow={item.value}
            aria-valuemin={0}
            aria-valuemax={maxValue}
            aria-label={`${item.label}: ${item.value}${unit}`}
          >
            <span class="text-white text-xs font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
              {Math.round(item.percentage)}%
            </span>
          </div>
        </div>

        {item.description && (
          <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
            {item.description}
          </p>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .chart-component {
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chart-bar-wrapper {
    animation: slideIn 0.6s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Animate bars on page load */
  .chart-bar-wrapper > div > div {
    animation: expandBar 1s ease-out;
  }

  @keyframes expandBar {
    from {
      width: 0 !important;
    }
  }
</style>
