---
/**
 * CodeComparison Component
 *
 * Side-by-side code comparison for before/after examples
 *
 * Usage:
 * <CodeComparison>
 *   <Fragment slot="before">
 *     ```javascript
 *     const oldCode = 'here';
 *     ```
 *   </Fragment>
 *   <Fragment slot="after">
 *     ```javascript
 *     const newCode = 'here';
 *     ```
 *   </Fragment>
 * </CodeComparison>
 */

interface Props {
  title?: string;
  beforeLabel?: string;
  afterLabel?: string;
  layout?: 'horizontal' | 'vertical';
}

const {
  title,
  beforeLabel = 'Before',
  afterLabel = 'After',
  layout = 'horizontal',
} = Astro.props;

const layoutClass =
  layout === 'horizontal'
    ? 'grid grid-cols-1 lg:grid-cols-2 gap-4'
    : 'flex flex-col gap-4';
---

<div class="code-comparison my-8 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
  {title && (
    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6">
      {title}
    </h3>
  )}

  <div class={layoutClass}>
    <!-- Before Section -->
    <div class="comparison-section before">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-red-600 dark:text-red-400 text-xl" aria-hidden="true">❌</span>
        <h4 class="text-sm font-semibold text-red-600 dark:text-red-400 uppercase tracking-wide">
          {beforeLabel}
        </h4>
      </div>
      <div class="comparison-content border-l-4 border-red-500 pl-4">
        <slot name="before" />
      </div>
    </div>

    <!-- After Section -->
    <div class="comparison-section after">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-green-600 dark:text-green-400 text-xl" aria-hidden="true">✅</span>
        <h4 class="text-sm font-semibold text-green-600 dark:text-green-400 uppercase tracking-wide">
          {afterLabel}
        </h4>
      </div>
      <div class="comparison-content border-l-4 border-green-500 pl-4">
        <slot name="after" />
      </div>
    </div>
  </div>
</div>

<style>
  .code-comparison {
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .comparison-section {
    animation: slideIn 0.6s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .comparison-content :global(pre) {
    margin: 0;
    border-radius: 0.5rem;
  }

  .comparison-content :global(code) {
    font-size: 0.875rem;
  }

  /* Hover effects */
  .comparison-section.before:hover .comparison-content {
    border-left-color: rgb(220 38 38);
  }

  .comparison-section.after:hover .comparison-content {
    border-left-color: rgb(34 197 94);
  }
</style>
