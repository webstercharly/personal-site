---
/**
 * Mermaid Diagram Component
 *
 * Renders Mermaid diagrams for flowcharts, sequence diagrams, architecture, etc.
 *
 * Usage:
 * <Mermaid
 *   diagram={`
 *     graph TD
 *       A[Client] --> B[Load Balancer]
 *       B --> C[Server1]
 *       B --> D[Server2]
 *   `}
 *   caption="Load balancer architecture"
 * />
 *
 * Or use the slot:
 * <Mermaid caption="My Diagram">
 *   graph TD
 *     A[Start] --> B[Process]
 *     B --> C[End]
 * </Mermaid>
 */

interface Props {
  diagram?: string;
  caption?: string;
  theme?: 'default' | 'dark' | 'neutral';
}

const { diagram, caption, theme = 'default' } = Astro.props;

const diagramId = `mermaid-${Math.random().toString(36).substring(2, 9)}`;
const slotContent = diagram ? null : await Astro.slots.render('default');
function decodeHtmlEntities(text: string): string {
  const entities: Record<string, string> = {
    '&amp;': '&',
    '&lt;': '<',
    '&gt;': '>',
    '&quot;': '"',
    '&#39;': "'",
  };
  let decoded = text.replace(/&[^;]+;/g, (entity) => entities[entity] || entity);

  decoded = decoded.replace(/—>/g, '-->');
  decoded = decoded.replace(/—\.—>/g, '-.->');
  decoded = decoded.replace(/-\.—>/g, '-.->');

  return decoded;
}

let diagramContent = diagram || (slotContent ? slotContent.replace(/<[^>]*>/g, '').trim() : '');
diagramContent = decodeHtmlEntities(diagramContent);
---

<figure class="mermaid-component my-8">
  <div class="mermaid-wrapper p-6 rounded-xl shadow-sm" style="background-color: var(--color-card-bg); border: 1px solid var(--color-border);">
    <pre class="mermaid" style="background: transparent; text-align: center;" set:text={diagramContent}></pre>
  </div>

  {caption && (
    <figcaption class="mt-3 text-sm text-center italic" style="color: var(--color-text-muted);">
      {caption}
    </figcaption>
  )}
</figure>

<script is:inline>
  if (!window.mermaidLoaded) {
    const script = document.createElement('script');
    script.type = 'module';
    script.textContent = `
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';

      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
        securityLevel: 'loose',
        fontFamily: 'Inter, system-ui, sans-serif',
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          mermaid.run({ querySelector: '.mermaid' }).catch(err => {
            console.warn('Mermaid rendering failed:', err);
          });
        });
      } else {
        mermaid.run({ querySelector: '.mermaid' }).catch(err => {
          console.warn('Mermaid rendering failed:', err);
        });
      }

      window.addEventListener('theme-changed', () => {
        const newTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'default';
        mermaid.initialize({
          startOnLoad: false,
          theme: newTheme,
          securityLevel: 'loose',
          fontFamily: 'Inter, system-ui, sans-serif',
        });

        document.querySelectorAll('.mermaid').forEach((element) => {
          element.removeAttribute('data-processed');
        });

        mermaid.run({ querySelector: '.mermaid' }).catch(err => {
          console.warn('Mermaid theme update failed:', err);
        });
      });
    `;
    document.head.appendChild(script);
    window.mermaidLoaded = true;
  }
</script>

<style>
  .mermaid-component {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mermaid-wrapper {
    transition: all 0.3s ease;
  }

  .mermaid-wrapper:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .mermaid-wrapper :global(.mermaid) {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }

  .mermaid-wrapper :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
