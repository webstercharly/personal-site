---
interface Props {
  columns?: 2 | 3 | 4;
  title?: string;
  description?: string;
}

const { columns = 3, title, description } = Astro.props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};
---

<div class="metrics-grid-wrapper my-12">
  {title && (
    <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
      {title}
    </h3>
  )}
  {description && (
    <p class="text-gray-600 dark:text-gray-400 mb-6">
      {description}
    </p>
  )}

  <div class={`metrics-grid grid grid-cols-1 ${gridCols[columns]} gap-6`}>
    <slot />
  </div>
</div>

<style>
  .metrics-grid-wrapper {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .metrics-grid {
    animation: slideUp 0.7s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
