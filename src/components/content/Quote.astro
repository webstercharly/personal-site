---
/**
 * Quote Component
 *
 * Usage:
 * <Quote author="Martin Fowler" source="Refactoring" url="https://...">
 *   Any fool can write code that a computer can understand.
 *   Good programmers write code that humans can understand.
 * </Quote>
 */

interface Props {
  author?: string;
  source?: string;
  url?: string;
  variant?: 'default' | 'centered' | 'large';
}

const { author, source, url, variant = 'default' } = Astro.props;

const variants = {
  default: 'text-lg',
  centered: 'text-lg text-center mx-auto max-w-3xl',
  large: 'text-2xl md:text-3xl font-light text-center mx-auto max-w-4xl',
};
---

<figure class={`quote-component my-8 ${variants[variant]}`}>
  <blockquote class="relative px-8 py-6 border-l-4 rounded-r-xl shadow-sm transition-all duration-300" style="border-color: var(--color-accent); background: linear-gradient(135deg, var(--color-card-bg) 0%, transparent 100%);">
    {variant === 'large' && (
      <span class="absolute top-2 left-2 text-6xl font-serif leading-none opacity-10" style="color: var(--color-accent);" aria-hidden="true">
        "
      </span>
    )}
    <div class={`${variant === 'large' ? 'relative z-10' : ''} text-gray-800 dark:text-gray-200 italic leading-relaxed`}>
      <slot />
    </div>

    {(author || source) && (
      <footer class="mt-4 pt-4 border-t" style="border-color: var(--color-border);">
        <cite class="text-sm not-italic block" style="color: var(--color-text-muted);">
          {author && (
            <span class="font-semibold" style="color: var(--color-text);">
              — {author}
            </span>
          )}
          {source && (
            <>
              {author && ', '}
              {url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline transition-colors"
                  style="color: var(--color-accent);"
                >
                  {source}
                </a>
              ) : (
                <span class="italic">{source}</span>
              )}
            </>
          )}
        </cite>
      </footer>
    )}
  </blockquote>
</figure>

<style>
  .quote-component blockquote {
    transition: all 0.3s ease;
  }

  .quote-component:hover blockquote {
    transform: translateX(4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
</style>
