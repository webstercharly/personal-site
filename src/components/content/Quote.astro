---
/**
 * Quote Component
 *
 * Usage:
 * <Quote author="Martin Fowler" source="Refactoring" url="https://...">
 *   Any fool can write code that a computer can understand.
 *   Good programmers write code that humans can understand.
 * </Quote>
 */

interface Props {
  author?: string;
  source?: string;
  url?: string;
  variant?: 'default' | 'centered' | 'large';
}

const { author, source, url, variant = 'default' } = Astro.props;

const variants = {
  default: 'text-lg',
  centered: 'text-lg text-center mx-auto max-w-3xl',
  large: 'text-2xl md:text-3xl font-light text-center mx-auto max-w-4xl',
};
---

<figure class={`quote-component my-8 ${variants[variant]}`}>
  <blockquote class="relative p-6 border-l-4 border-blue-500 bg-gray-50 dark:bg-gray-800 rounded-r-lg">
    {variant === 'large' && (
      <span class="absolute top-2 left-2 text-6xl text-blue-500/20 font-serif leading-none" aria-hidden="true">
        "
      </span>
    )}
    <div class={`${variant === 'large' ? 'relative z-10' : ''} text-gray-800 dark:text-gray-200 italic`}>
      <slot />
    </div>
  </blockquote>

  {(author || source) && (
    <figcaption class="mt-4 text-sm text-gray-600 dark:text-gray-400">
      {author && (
        <cite class="font-semibold not-italic text-gray-900 dark:text-gray-100">
          — {author}
        </cite>
      )}
      {source && (
        <>
          {author && ', '}
          {url ? (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 dark:text-blue-400 hover:underline"
            >
              {source}
            </a>
          ) : (
            <span class="italic">{source}</span>
          )}
        </>
      )}
    </figcaption>
  )}
</figure>

<style>
  .quote-component blockquote {
    transition: all 0.2s ease;
  }

  .quote-component:hover blockquote {
    border-left-color: rgb(59 130 246);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
</style>
