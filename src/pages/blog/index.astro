---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { WORDS_PER_MINUTE } from '../../lib/constants';

let posts: CollectionEntry<'blog'>[] = [];
let postsByYear: Record<number, CollectionEntry<'blog'>[]> = {};
let years: string[] = [];

try {
  const allPosts = await getCollection('blog');
  posts = allPosts
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  postsByYear = posts.reduce((acc, post) => {
    const year = post.data.pubDate.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {} as Record<number, CollectionEntry<'blog'>[]>);

  years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
} catch (err) {
  console.error('Failed to load blog posts:', err);
}
---

<BaseLayout
  title="Blog - Charly Webster"
  description="Articles about engineering leadership, software architecture, testing strategies, and building high-performing teams."
>
  <Navigation />

  <main id="main-content" class="container pb-12">
    <div class="max-w-4xl mx-auto">
      <div class="pt-20 mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Blog</h1>
        <p class="text-lg" style="color: var(--color-text-muted);">
          Thoughts on engineering leadership, software architecture, and team building.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-600 dark:text-gray-400 text-lg">
            No posts published yet. Check back soon!
          </p>
        </div>
      ) : (
        years.map((year) => (
          <section class="mb-16">
            <h2 class="text-3xl font-bold mb-6 pb-3 text-gray-900 dark:text-white border-b-2" style="border-color: var(--color-border);">{year}</h2>
            <div class="space-y-6">
              {postsByYear[Number(year)]?.map((post) => {
                const readingTime = Math.ceil(post.body.split(/\s+/).length / WORDS_PER_MINUTE);
                return (
                <article class="p-6 rounded-lg bg-gray-50 dark:bg-gray-800 hover:shadow-lg transition-all duration-300 hover:scale-[1.02]">
                  <a href={`/blog/${post.slug}`} class="group">
                    <div class="flex items-center gap-3 text-sm mb-2" style="color: var(--color-text-muted);">
                      <time>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      <span>•</span>
                      <span>{readingTime} min read</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-3 transition-colors" style="color: var(--color-text);" onmouseenter="this.style.color = 'var(--color-accent)'" onmouseleave="this.style.color = 'var(--color-text)'">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                      {post.data.description}
                    </p>
                    {post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="px-3 py-1 text-xs font-medium rounded-full transition-all duration-200 hover:scale-110" style="background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to)); color: white; opacity: 0.9;">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </a>
                </article>
                );
              })}
            </div>
          </section>
        ))
      )}
    </div>
  </main>
</BaseLayout>
