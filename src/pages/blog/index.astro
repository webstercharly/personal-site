---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import { WORDS_PER_MINUTE } from '../../lib/constants';
import { getPosts, type Post } from '../../lib/posts';

let posts: Post[] = [];
let postsByYear: Record<number, Post[]> = {};
let years: string[] = [];

try {
  posts = await getPosts();
  postsByYear = posts.reduce((acc, post) => {
    const year = post.data.pubDate.getFullYear();
    (acc[year] ??= []).push(post);
    return acc;
  }, {} as Record<number, Post[]>);
  years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
} catch (error) {
  console.error('Failed to load blog posts:', error);
}
---

<BaseLayout
  title="Writing — Charly Webster"
  description="Writing by Charly Webster about engineering leadership, software architecture, teams, and applied AI."
>
  <Navigation />

  <main id="main-content" class="writing-shell">
    <header class="page-header fade-in">
      <p class="eyebrow">Notes from the work</p>
      <h1>Writing</h1>
      <p>Thoughts on engineering leadership, software architecture, teams, and applied AI.</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty-state">No posts published yet. Check back soon.</p>
    ) : (
      years.map((year) => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ol class="post-list">
            {postsByYear[Number(year)]?.map((post, index) => {
              const readingTime = Math.ceil((post.body ?? '').split(/\s+/).length / WORDS_PER_MINUTE);
              const accents = ['accent-green', 'accent-pink', 'accent-yellow'];
              return (
                <li>
                  <article>
                    <div class="post-meta">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                      </time>
                      <span aria-hidden="true">·</span>
                      <span>{readingTime} min read</span>
                    </div>
                    <h3>
                      <a class={`post-title ${accents[index % accents.length]}`} href={`/blog/${post.id}`}>
                        {post.data.title}
                      </a>
                    </h3>
                    <p>{post.data.description}</p>
                    {post.data.tags.length > 0 && (
                      <ul class="tag-list" aria-label="Topics">
                        {post.data.tags.map((tag) => <li>#{tag}</li>)}
                      </ul>
                    )}
                  </article>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    )}
  </main>
</BaseLayout>

<style>
  .writing-shell {
    width: min(100% - 2rem, 760px);
    margin-inline: auto;
    padding-bottom: 5rem;
  }

  .page-header {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .eyebrow,
  .post-meta,
  .tag-list,
  .year-group > h2 {
    font-family: var(--font-mono);
  }

  .eyebrow {
    margin-bottom: 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 760;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .page-header > p:last-child {
    max-width: 58ch;
    margin-top: 1.4rem;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }

  .year-group {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding-block: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .year-group > h2 {
    color: var(--color-text-soft);
    font-size: 0.85rem;
  }

  .post-list,
  .tag-list {
    padding: 0;
    list-style: none;
  }

  .post-list > li + li {
    margin-top: 2.8rem;
  }

  .post-meta {
    display: flex;
    gap: 0.45rem;
    color: var(--color-text-soft);
    font-size: 0.75rem;
  }

  h3 {
    margin-block: 0.4rem 0.65rem;
    font-size: clamp(1.35rem, 4vw, 1.8rem);
    line-height: 1.25;
  }

  .post-title {
    color: var(--color-text);
    font-weight: 750;
    text-decoration: none;
    background-image: linear-gradient(var(--link-accent), var(--link-accent));
    background-position: 0 96%;
    background-repeat: no-repeat;
    background-size: 100% 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 150ms ease;
  }

  .post-title:hover {
    background-size: 100% 0.2em;
  }

  .accent-green { --link-accent: var(--color-accent-green); }
  .accent-pink { --link-accent: var(--color-accent-pink); }
  .accent-yellow { --link-accent: var(--color-accent-yellow); }

  article > p {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 0.8rem;
    color: var(--color-text-soft);
    font-size: 0.75rem;
  }

  .empty-state {
    padding-block: 4rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
