---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { RECENT_POSTS_COUNT, WORDS_PER_MINUTE } from '../lib/constants';
import { Image } from 'astro:assets';

// Import images from public folder
import authorImg from '../../public/images/author.jpg';
import githubIcon from '../../public/images/github.png';
import linkedinIcon from '../../public/images/linkedin.png';
import mediumIcon from '../../public/images/medium.png';
import twitterIcon from '../../public/images/twitter.png';
import emailIcon from '../../public/images/email.png';

let recentPosts: CollectionEntry<'blog'>[] = [];

try {
  const allPosts = await getCollection('blog');
  recentPosts = allPosts
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, RECENT_POSTS_COUNT);
} catch (error) {
  console.error('Failed to load blog posts:', error);
}
---

<BaseLayout
  title="Charly Webster - Head of Software Engineering"
  description="Personal website and blog of Charly Webster, Head of Software Engineering. Sharing insights on engineering leadership, software architecture, and team building."
>
  <Navigation />

  <main id="main-content" class="relative overflow-hidden">
    <!-- Retro Gaming Background -->
    <div class="retro-bg absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
      <!-- Pixel Grid Pattern -->
      <div class="pixel-grid absolute inset-0 opacity-30"></div>

      <!-- Scanlines Effect -->
      <div class="scanlines absolute inset-0 opacity-10"></div>

      <!-- Floating Geometric Shapes -->
      <div class="geometric-shapes">
        <!-- Tetris-like blocks -->
        <div class="geo-shape tetris-l" style="top: 10%; left: 5%;"></div>
        <div class="geo-shape tetris-square" style="top: 60%; left: 10%;"></div>
        <div class="geo-shape tetris-t" style="top: 30%; right: 8%;"></div>
        <div class="geo-shape tetris-z" style="bottom: 20%; right: 15%;"></div>

        <!-- Triangles -->
        <div class="geo-shape triangle" style="top: 50%; left: 15%;"></div>
        <div class="geo-shape triangle triangle-flip" style="top: 20%; right: 20%;"></div>
        <div class="geo-shape triangle" style="bottom: 30%; left: 25%;"></div>

        <!-- Hexagons -->
        <div class="geo-shape hexagon" style="top: 70%; right: 10%;"></div>
        <div class="geo-shape hexagon" style="top: 15%; left: 30%;"></div>

        <!-- Pixels (small squares) -->
        <div class="geo-shape pixel" style="top: 25%; left: 20%;"></div>
        <div class="geo-shape pixel" style="top: 45%; right: 25%;"></div>
        <div class="geo-shape pixel" style="bottom: 40%; left: 35%;"></div>
        <div class="geo-shape pixel" style="top: 80%; right: 30%;"></div>
      </div>
    </div>

    <!-- Hero Section -->
    <section class="container py-20 md:py-32">
      <div class="max-w-4xl mx-auto text-center fade-in-up">
        <div class="mb-8">
          <Image
            src={authorImg}
            alt="Charly Webster"
            width={160}
            height={160}
            quality={85}
            loading="eager"
            class="w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto object-cover border-4 border-gray-200 dark:border-gray-700 shadow-lg float"
          />
        </div>

        <h1 class="text-4xl md:text-6xl font-bold mb-6 bg-gradient-to-r gradient-animate bg-clip-text text-transparent" style="background-image: linear-gradient(to right, var(--gradient-from), var(--gradient-to));">
          Charly Webster
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-8">
          Head of Software Engineering
        </p>

        <p class="text-lg text-gray-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto leading-relaxed">
          Building high-performing engineering teams and scalable systems.
          Passionate about engineering leadership, software architecture, and fostering engineering excellence.
        </p>

        <!-- Social Links -->
        <div class="flex justify-center gap-3 mb-16">
          <a
            href="https://github.com/webstercharly"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="GitHub"
          >
            <Image src={githubIcon} alt="GitHub" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://www.linkedin.com/in/charlywebster"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="LinkedIn"
          >
            <Image src={linkedinIcon} alt="LinkedIn" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://medium.com/@CharlyWebster"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="Medium"
          >
            <Image src={mediumIcon} alt="Medium" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://twitter.com/webstercharly"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="Twitter"
          >
            <Image src={twitterIcon} alt="Twitter" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="mailto:charly.webster92&#64;<!--nospam-->gmail&#46;com"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="Email"
          >
            <Image src={emailIcon} alt="Email" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-5 justify-center">
          <a
            href="/blog"
            class="px-10 py-4 text-white font-semibold text-lg rounded-xl transition-all duration-300 shadow-lg hover:shadow-2xl hover:scale-105 hover:brightness-110"
            style="background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to));"
          >
            Read My Blog
          </a>
          <a
            href="mailto:charly.webster92&#64;<!--nospam-->gmail&#46;com"
            class="px-10 py-4 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold text-lg rounded-xl transition-all duration-300 hover:scale-105 border-2 border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 shadow-md hover:shadow-lg"
          >
            Get In Touch
          </a>
        </div>
      </div>
    </section>

    <!-- Recent Posts Section -->
    {recentPosts.length > 0 && (
      <section class="container border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-4xl mx-auto pt-20 pb-8">
          <div class="flex items-center justify-between mb-10">
            <h2 class="text-3xl font-bold">Recent Posts</h2>
            <a
              href="/blog"
              class="font-medium hover:underline transition-colors"
              style="color: var(--color-accent);"
            >
              View all →
            </a>
          </div>

          <div class="grid gap-6">
            {recentPosts.map((post, index) => {
              const readingTime = Math.ceil(post.body.split(/\s+/).length / WORDS_PER_MINUTE);
              return (
              <article class="p-6 rounded-lg bg-gray-50 dark:bg-gray-800 hover:shadow-lg transition-all duration-300 hover:scale-[1.02] slide-in-right" style={`animation-delay: ${index * 0.1}s`}>
                <a href={`/blog/${post.slug}`} class="group">
                  <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400 mb-2">
                    <time>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span>•</span>
                    <span>{readingTime} min read</span>
                  </div>
                  <h3 class="text-xl font-bold mb-3 transition-colors" style="color: var(--color-text);" onmouseenter="this.style.color = 'var(--color-accent)'" onmouseleave="this.style.color = 'var(--color-text)'">
                    {post.data.title}
                  </h3>
                  <p class="text-gray-700 dark:text-gray-300 mb-4">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="px-3 py-1 text-xs font-medium rounded-full transition-all duration-200 hover:scale-110" style="background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to)); color: white; opacity: 0.9;">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- Footer -->
  <footer class="border-t mt-20" style="border-color: var(--color-border); background: linear-gradient(to bottom, transparent, var(--color-card-bg));">
    <div class="container py-12">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <!-- Left side - Copyright -->
          <div class="text-center md:text-left">
            <p class="font-semibold text-lg mb-1" style="color: var(--color-text);">Charly Webster</p>
            <p class="text-sm" style="color: var(--color-text-muted);">
              &copy; {new Date().getFullYear()} All rights reserved.
            </p>
          </div>

          <!-- Right side - Links -->
          <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
            <a href="/blog" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">Blog</a>
            <a href="https://github.com/webstercharly" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">GitHub</a>
            <a href="https://www.linkedin.com/in/charlywebster" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">LinkedIn</a>
            <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-muted);">
              <span>Built with</span>
              <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-medium hover:underline transition-colors inline-flex items-center gap-1" style="color: var(--color-accent);">
                Astro
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== RETRO GAMING BACKGROUND ===== */

  /* Pixel Grid Pattern */
  .pixel-grid {
    background-image:
      linear-gradient(0deg, rgba(99, 102, 241, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.1) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  :global(.dark) .pixel-grid {
    background-image:
      linear-gradient(0deg, rgba(99, 102, 241, 0.2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.2) 1px, transparent 1px);
  }

  /* Scanlines Effect */
  .scanlines {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.1) 0px,
      rgba(0, 0, 0, 0.1) 1px,
      transparent 1px,
      transparent 2px
    );
    pointer-events: none;
  }

  /* Geometric Shapes Container */
  .geometric-shapes {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Base shape styling */
  .geo-shape {
    position: absolute;
    opacity: 0.15;
  }

  :global(.dark) .geo-shape {
    opacity: 0.25;
  }

  /* Tetris L Block */
  .tetris-l {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    box-shadow:
      20px 0 0 #06b6d4,
      40px 0 0 #06b6d4,
      40px 20px 0 #0891b2;
    animation: float-rotate 20s infinite ease-in-out;
  }

  /* Tetris Square */
  .tetris-square {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    box-shadow:
      20px 0 0 #f59e0b,
      0 20px 0 #d97706,
      20px 20px 0 #d97706;
    animation: float-rotate 25s infinite ease-in-out reverse;
  }

  /* Tetris T Block */
  .tetris-t {
    width: 60px;
    height: 40px;
    background: linear-gradient(135deg, #a855f7, #9333ea);
    box-shadow:
      20px 0 0 #a855f7,
      40px 0 0 #a855f7,
      20px 20px 0 #9333ea;
    animation: float-rotate 22s infinite ease-in-out;
  }

  /* Tetris Z Block */
  .tetris-z {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #ec4899, #db2777);
    box-shadow:
      20px 0 0 #ec4899,
      20px 20px 0 #db2777,
      40px 20px 0 #db2777;
    animation: float-rotate 18s infinite ease-in-out;
  }

  /* Triangle */
  .triangle {
    width: 0;
    height: 0;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 70px solid #10b981;
    opacity: 0.2;
    animation: float-slow 15s infinite ease-in-out;
  }

  .triangle-flip {
    border-bottom: none;
    border-top: 70px solid #3b82f6;
    animation: float-slow 20s infinite ease-in-out reverse;
  }

  :global(.dark) .triangle {
    border-bottom-color: #059669;
  }

  :global(.dark) .triangle-flip {
    border-top-color: #2563eb;
  }

  /* Hexagon */
  .hexagon {
    width: 50px;
    height: 29px;
    background: #8b5cf6;
    position: relative;
    animation: float-rotate 30s infinite ease-in-out;
  }

  .hexagon:before,
  .hexagon:after {
    content: "";
    position: absolute;
    width: 0;
    border-left: 25px solid transparent;
    border-right: 25px solid transparent;
  }

  .hexagon:before {
    bottom: 100%;
    border-bottom: 14.5px solid #8b5cf6;
  }

  .hexagon:after {
    top: 100%;
    border-top: 14.5px solid #8b5cf6;
  }

  /* Small Pixel Squares */
  .pixel {
    width: 16px;
    height: 16px;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    animation: pulse-pixel 3s infinite ease-in-out;
  }

  /* Animations */
  @keyframes float-rotate {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(20px, -20px) rotate(90deg);
    }
    50% {
      transform: translate(0, -40px) rotate(180deg);
    }
    75% {
      transform: translate(-20px, -20px) rotate(270deg);
    }
  }

  @keyframes float-slow {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-30px) rotate(10deg);
    }
  }

  @keyframes pulse-pixel {
    0%, 100% {
      transform: scale(1);
      opacity: 0.15;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.3;
    }
  }

  /* Accessibility: Respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .geo-shape,
    .tetris-l,
    .tetris-square,
    .tetris-t,
    .tetris-z,
    .triangle,
    .triangle-flip,
    .hexagon,
    .pixel {
      animation: none;
    }
  }

  /* Ensure sufficient contrast by reducing opacity on light backgrounds */
  @media (prefers-color-scheme: light) {
    .geo-shape {
      opacity: 0.12;
    }
  }
</style>
