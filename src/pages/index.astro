---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { RECENT_POSTS_COUNT, WORDS_PER_MINUTE } from '../lib/constants';
import { getPosts, type Post } from '../lib/posts';
import { Image } from 'astro:assets';

import authorImg from '../../public/images/author.jpg';
import githubIcon from '../../public/images/github.png';
import linkedinIcon from '../../public/images/linkedin.png';
import mediumIcon from '../../public/images/medium.png';
import twitterIcon from '../../public/images/twitter.png';

let recentPosts: Post[] = [];

try {
  recentPosts = (await getPosts()).slice(0, RECENT_POSTS_COUNT);
} catch (error) {
  console.error('Failed to load blog posts:', error);
}
---

<BaseLayout
  title="Charly Webster - Head of Software Engineering"
  description="Personal website and blog of Charly Webster, Head of Software Engineering. Sharing insights on engineering leadership, software architecture, and team building."
>
  <Navigation />

  <main id="main-content" class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-gradient-to-br from-emerald-200/30 to-emerald-400/20 dark:from-emerald-500/10 dark:to-emerald-700/10 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-gradient-to-br from-teal-200/30 to-teal-400/20 dark:from-teal-500/10 dark:to-teal-700/10 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-gradient-to-br from-green-200/30 to-green-400/20 dark:from-green-500/10 dark:to-green-700/10 rounded-full blur-3xl animate-blob animation-delay-4000"></div>
    </div>

    <section class="container py-20 md:py-32">
      <div class="max-w-4xl mx-auto text-center fade-in-up">
        <div class="mb-8">
          <Image
            src={authorImg}
            alt="Charly Webster"
            width={160}
            height={160}
            quality={85}
            loading="eager"
            class="w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto object-cover border-4 border-gray-200 dark:border-gray-700 shadow-lg float"
          />
        </div>

        <h1 class="text-4xl md:text-6xl font-bold mb-6 bg-gradient-to-r gradient-animate bg-clip-text text-transparent" style="background-image: linear-gradient(to right, var(--gradient-from), var(--gradient-to));">
          Charly Webster
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-8">
          Head of Software Engineering
        </p>

        <p class="text-lg text-gray-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto leading-relaxed">
          Building high-performing engineering teams and scalable systems.
          Passionate about engineering leadership, software architecture, and fostering engineering excellence.
        </p>

        <div class="flex justify-center gap-3 mb-16">
          <a
            href="https://github.com/webstercharly"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="GitHub"
          >
            <Image src={githubIcon} alt="GitHub" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://www.linkedin.com/in/charlywebster"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="LinkedIn"
          >
            <Image src={linkedinIcon} alt="LinkedIn" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://medium.com/@CharlyWebster"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="Medium"
          >
            <Image src={mediumIcon} alt="Medium" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
          <a
            href="https://twitter.com/webstercharly"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-110 hover:shadow-md"
            aria-label="Twitter"
          >
            <Image src={twitterIcon} alt="Twitter" width={28} height={28} loading="lazy" class="w-7 h-7" />
          </a>
        </div>

        <div class="flex justify-center">
          <a
            href="/blog"
            class="px-10 py-4 text-white font-semibold text-lg rounded-xl transition-all duration-300 shadow-lg hover:shadow-2xl hover:scale-105 hover:brightness-110"
            style="background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to));"
          >
            Read My Blog
          </a>
        </div>
      </div>
    </section>

    {recentPosts.length > 0 && (
      <section class="container border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-4xl mx-auto pt-20 pb-8">
          <div class="flex items-center justify-between mb-10">
            <h2 class="text-3xl font-bold">Recent Posts</h2>
            <a
              href="/blog"
              class="font-medium hover:underline transition-colors"
              style="color: var(--color-accent);"
            >
              View all →
            </a>
          </div>

          <div class="grid gap-6">
            {recentPosts.map((post, index) => {
              const readingTime = Math.ceil((post.body ?? "").split(/\s+/).length / WORDS_PER_MINUTE);
              return (
              <article class="p-6 rounded-lg bg-gray-50 dark:bg-gray-800 hover:shadow-lg transition-all duration-300 hover:scale-[1.02] slide-in-right" style={`animation-delay: ${index * 0.1}s`}>
                <a href={`/blog/${post.id}`} class="group">
                  <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400 mb-2">
                    <time>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span>•</span>
                    <span>{readingTime} min read</span>
                  </div>
                  <h3 class="text-xl font-bold mb-3 transition-colors" style="color: var(--color-text);" onmouseenter="this.style.color = 'var(--color-accent)'" onmouseleave="this.style.color = 'var(--color-text)'">
                    {post.data.title}
                  </h3>
                  <p class="text-gray-700 dark:text-gray-300 mb-4">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="px-3 py-1 text-xs font-medium rounded-full transition-all duration-200 hover:scale-110" style="background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to)); color: white; opacity: 0.9;">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="border-t mt-20" style="border-color: var(--color-border); background: linear-gradient(to bottom, transparent, var(--color-card-bg));">
    <div class="container py-12">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="text-center md:text-left">
            <p class="font-semibold text-lg mb-1" style="color: var(--color-text);">Charly Webster</p>
            <p class="text-sm" style="color: var(--color-text-muted);">
              &copy; {new Date().getFullYear()} All rights reserved.
            </p>
          </div>

          <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
            <a href="/blog" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">Blog</a>
            <a href="https://github.com/webstercharly" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">GitHub</a>
            <a href="https://www.linkedin.com/in/charlywebster" target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:underline transition-colors" style="color: var(--color-text-muted);">LinkedIn</a>
            <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-muted);">
              <span>Built with</span>
              <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-medium hover:underline transition-colors inline-flex items-center gap-1" style="color: var(--color-accent);">
                Astro
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
