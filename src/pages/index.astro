---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { RECENT_POSTS_COUNT, WORDS_PER_MINUTE } from '../lib/constants';
import { getPosts, type Post } from '../lib/posts';
import { Image } from 'astro:assets';

import authorImg from '../../public/images/author.jpg';

let recentPosts: Post[] = [];

try {
  recentPosts = (await getPosts()).slice(0, RECENT_POSTS_COUNT);
} catch (error) {
  console.error('Failed to load blog posts:', error);
}
---

<BaseLayout
  title="Charly Webster — Head of AI Engineering"
  description="Charly Webster leads a centralised AI Product Engineering Centre of Excellence, building forward with AI and turning business opportunities into production-ready products."
  image="/og/site.png"
  imageAlt="Charly Webster — Head of AI Engineering. Behind better experiences."
>
  <Navigation />

  <main id="main-content" class="home-shell">
    <header class="intro">
      <div class="intro-copy fade-in">
        <p class="eyebrow">Head of AI Engineering.</p>
        <h1>Behind better experiences.</h1>
        <p class="lede">
          I lead a centralised AI Product Engineering Centre of Excellence at M&amp;S. Building forward
          with AI, we partner with the business to turn high-value opportunities into production-ready
          products, enabled by a governed, scalable AI platform.
        </p>
      </div>

      <div class="portrait-frame fade-in" aria-hidden="true">
        <span class="portrait-accent"></span>
        <Image
          src={authorImg}
          alt=""
          width={320}
          height={320}
          quality={90}
          loading="eager"
          class="portrait"
        />
      </div>
    </header>

    <section class="about-section" aria-labelledby="about-heading">
      <h2 id="about-heading">A bit about me</h2>
      <div class="about-copy">
        <p>
          I care about building healthy engineering organisations and dependable software:
          clear direction, pragmatic architecture, and teams with the space to do their best work.
        </p>
        <p>
          This is where I share what I’m learning about leadership, technology, and turning
          complicated customer problems into useful products.
        </p>
        <p class="inline-links">
          You can also find me on&nbsp;<a class="accent-link accent-pink" href="https://www.linkedin.com/in/charlywebster" target="_blank" rel="noopener noreferrer">LinkedIn</a>&nbsp;and&nbsp;<a class="accent-link accent-yellow" href="https://github.com/webstercharly" target="_blank" rel="noopener noreferrer">GitHub</a>.
        </p>
      </div>
    </section>

    {recentPosts.length > 0 && (
      <section class="writing-section" aria-labelledby="writing-heading">
        <div class="section-heading">
          <h2 id="writing-heading">Latest writing</h2>
          <a class="accent-link accent-yellow view-all" href="/blog">All posts <span aria-hidden="true">→</span></a>
        </div>

        <ol class="post-list">
          {recentPosts.map((post, index) => {
            const readingTime = Math.ceil((post.body ?? '').split(/\s+/).length / WORDS_PER_MINUTE);
            const accents = ['accent-green', 'accent-pink', 'accent-yellow'];
            return (
              <li class="post-item">
                <article>
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{readingTime} min read</span>
                  </div>
                  <h3>
                    <a class={`post-title accent-link ${accents[index % accents.length]}`} href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="tag-list" aria-label="Topics">
                      {post.data.tags.map((tag) => <li>#{tag}</li>)}
                    </ul>
                  )}
                </article>
              </li>
            );
          })}
        </ol>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; {new Date().getFullYear()} Charly Webster.</p>
      <p>
        Built with&nbsp;<a class="accent-link accent-green" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.&nbsp;<a class="accent-link accent-pink" href="https://github.com/webstercharly/personal-site" target="_blank" rel="noopener noreferrer">Source on GitHub</a>.
      </p>
    </div>
  </footer>
</BaseLayout>

<script>
  const portraitFrame = document.querySelector<HTMLElement>('.portrait-frame');

  if (portraitFrame) {
    const isDark = document.documentElement.classList.contains('dark');
    const accents = isDark
      ? ['#45d582', '#fa72a8', '#f2ca5b']
      : ['#27b467', '#e8548f', '#e6b93f'];
    const randomValue = crypto.getRandomValues(new Uint32Array(1))[0] ?? 0;
    const randomIndex = randomValue % accents.length;
    const selectedAccent = accents[randomIndex] ?? (isDark ? '#45d582' : '#27b467');
    portraitFrame.style.setProperty('--portrait-accent', selectedAccent);
  }
</script>

<style>
  .home-shell,
  .footer-inner {
    width: min(100% - 2rem, 760px);
    margin-inline: auto;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: clamp(2rem, 7vw, 5rem);
    align-items: center;
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(4rem, 8vw, 6rem);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.35rem, 7vw, 4.35rem);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .lede {
    max-width: 53ch;
    margin-top: 1.75rem;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .portrait-frame {
    position: relative;
    isolation: isolate;
  }

  .portrait-accent {
    position: absolute;
    inset: 12px -12px -12px 12px;
    z-index: -1;
    background: var(--portrait-accent, var(--color-accent-yellow));
    border: 2px solid var(--color-text);
    border-radius: 42% 58% 48% 52% / 53% 42% 58% 47%;
    transform: rotate(3deg);
  }

  :global(.portrait) {
    aspect-ratio: 1;
    border: 2px solid var(--color-text);
    border-radius: 52% 48% 58% 42% / 43% 55% 45% 57%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.04);
  }

  .about-section,
  .writing-section {
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    border-top: 1px solid var(--color-border);
  }

  .about-section {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 2rem;
  }

  h2 {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .about-copy {
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .about-copy p + p {
    margin-top: 1.2rem;
  }

  .inline-links {
    color: var(--color-text-muted);
  }

  .accent-link {
    color: inherit;
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--link-accent, var(--color-accent-green));
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.24em;
    text-decoration-skip-ink: auto;
    transition: color 150ms ease, text-decoration-thickness 150ms ease;
  }

  .accent-link:hover {
    color: var(--color-text);
    text-decoration-thickness: 0.22em;
  }

  .accent-green { --link-accent: var(--color-accent-green); }
  .accent-pink { --link-accent: var(--color-accent-pink); }
  .accent-yellow { --link-accent: var(--color-accent-yellow); }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .view-all {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-list,
  .tag-list {
    padding: 0;
    list-style: none;
  }

  .post-item + .post-item {
    margin-top: 2.5rem;
  }

  .post-item h3 {
    margin-block: 0.4rem 0.65rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .post-title {
    text-decoration: none;
    background-image: linear-gradient(var(--link-accent), var(--link-accent));
    background-position: 0 96%;
    background-repeat: no-repeat;
    background-size: 100% 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 150ms ease;
  }

  .post-title:hover {
    background-size: 100% 0.2em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .post-item article > p {
    max-width: 64ch;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 0.8rem;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .site-footer {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem 3rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .footer-inner p:last-child {
    text-align: right;
  }

  @media (max-width: 680px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 3.25rem;
    }

    .intro-copy {
      order: 2;
    }

    .portrait-frame {
      width: 132px;
      order: 1;
    }

    h1 {
      max-width: none;
      font-size: clamp(2.2rem, 12vw, 3.35rem);
    }

    .about-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .footer-inner {
      flex-direction: column;
      gap: 0.5rem;
    }

    .footer-inner p:last-child {
      text-align: left;
    }
  }
</style>
